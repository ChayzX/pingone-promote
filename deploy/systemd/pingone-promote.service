[Unit]
Description=pingone-promote hosted server
Documentation=https://github.com/ChayzX/pingone-promote/blob/main/docs/operations.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pingone-promote
Group=pingone-promote
DynamicUser=no
ExecStart=/opt/pingone-promote/pingone-promote serve --config /etc/pingone-promote/config.json
Restart=on-failure
RestartSec=5s
Environment=TMPDIR=/tmp HOME=/tmp

# Secrets: /etc/pingone-promote/secrets.env, mode 0400, owned by
# pingone-promote (the config's secretsFile). ProtectSystem=strict keeps it
# read-only for the service. On systemd 254 or newer you may instead use
#   LoadCredential=secrets:/etc/pingone-promote/secrets.env
# with secretsFile /run/credentials/pingone-promote.service/secrets (verified
# on systemd 255); systemd 252 (RHEL 9) did not give the service user access
# to the credential in testing, so it is not the default.

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadOnlyPaths=/opt/pingone-promote /etc/pingone-promote

[Install]
WantedBy=multi-user.target
