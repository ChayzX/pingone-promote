# pingone-promote secrets file. Copy to the path named by "secretsFile" in the
# configuration, fill in the values, then:  chmod 600 secrets.env
# (0400 also works). The server refuses a file readable by group or others.
# One NAME=value per line; no quotes needed; never commit the filled-in file.
PINGONE_PROMOTE_WORKER_CLIENT_ID=
PINGONE_PROMOTE_WORKER_CLIENT_SECRET=
PINGONE_PROMOTE_GITLAB_TOKEN=
